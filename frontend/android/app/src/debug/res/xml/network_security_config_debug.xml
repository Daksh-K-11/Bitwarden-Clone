<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug builds only. Cleartext is permitted so a phone on the same Wi-Fi
         can reach the development backend at http://<pc-lan-ip>:8000. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

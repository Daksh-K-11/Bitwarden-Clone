# Copy to backend/.env (never commit the real file).
# Cloudflare R2 -> Manage R2 API tokens -> "Object Read & Write" scoped to ONE bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=citadel-vault

# Firebase project id and path to a service-account JSON with no extra roles
# (verifying ID tokens needs none).
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

REQUIRE_APP_CHECK=false
REQUIRE_EMAIL_VERIFIED=true
URL_TTL_SECONDS=300
